# Public Supabase configuration. Only the publishable key belongs in the app.
# Never place the service role key or Razorpay secret in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: use the URL shown by `npx expo start` when testing email links.
# In production this should match the app scheme, for example:
# connectlocal://auth/callback
# EXPO_PUBLIC_AUTH_REDIRECT_URL=connectlocal://auth/callback

# Server-only values. Keep these in Supabase Edge Function secrets or your API
# host, never in the Expo bundle.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
